// HiveMind — Core schema
//
// Source of truth: ARCHITECTURE.md ("Required Core Entities").
// SQLite for development; kept conceptually PostgreSQL-compatible for production.
//
// Note: the Phase 1 placeholder models (Provider / Conversation / Message) were
// replaced by the architecture's canonical entities. Phase 2 uses User,
// Workspace, and WorkspaceMember; Phase 3 adds invitations/membership
// management; Phase 4 activates the AI agent foundation (Agent / RoomAgent —
// agent registry, profiles, and per-workspace default agents). The remaining
// models (rooms, memory, decisions) are defined here so later phases build on a
// stable schema without repeated migrations. Phase 11 adds the knowledge base
// (KnowledgeSource / KnowledgeChunk) for retrieval-augmented agent context.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A human user.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  messages        Message[]
  usageLogs       UsageLog[]
}

// A project or team space. The top-level container in HiveMind.
model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner            User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members          WorkspaceMember[]
  invitations      Invitation[]
  rooms            Room[]
  agents           Agent[]
  memoryItems      MemoryItem[]
  projectContexts  ProjectContext[]
  decisions        Decision[]
  knowledgeSources KnowledgeSource[]
  knowledgeChunks  KnowledgeChunk[]
  discussions      Discussion[]
  usageLogs        UsageLog[]

  @@index([ownerId])
}

// Connects a human user to a workspace, with a role.
// role: "owner" | "admin" | "member" | "viewer"
model WorkspaceMember {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        String   @default("member")
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// An invited user (email + role). Email delivery is deferred.
// status: "pending" | "accepted" | "rejected"
model Invitation {
  id          String   @id @default(cuid())
  workspaceId String
  email       String
  role        String   @default("member")
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// A focused discussion space inside a workspace.
model Room {
  id             String   @id @default(cuid())
  workspaceId    String
  name           String
  description    String?
  defaultAgentId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  defaultAgent     Agent?            @relation("RoomDefaultAgent", fields: [defaultAgentId], references: [id], onDelete: SetNull)
  messages         Message[]
  roomAgents       RoomAgent[]
  memoryItems      MemoryItem[]
  decisions        Decision[]
  knowledgeSources KnowledgeSource[]
  knowledgeChunks  KnowledgeChunk[]
  discussions      Discussion[]

  @@index([workspaceId])
}

// A chat message authored by a human, an AI agent, or the system.
// senderType: "human" | "agent" | "system"
// metadata: JSON string (mentionedAgentIds, provider, model, error, etc.)
model Message {
  id         String   @id @default(cuid())
  roomId     String
  senderType String
  userId     String?
  agentId    String?
  content    String
  metadata   String?
  createdAt  DateTime @default(now())

  room  Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([roomId])
}

// An AI teammate. Database-driven; identity is separate from provider/model.
model Agent {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  displayName  String
  provider     String
  model        String
  role         String
  systemPrompt String
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  roomAgents      RoomAgent[]
  messages        Message[]
  defaultForRooms Room[]      @relation("RoomDefaultAgent")

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// Join table connecting agents to rooms.
model RoomAgent {
  id        String   @id @default(cuid())
  roomId    String
  agentId   String
  createdAt DateTime @default(now())

  room  Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([roomId, agentId])
}

// Long-term curated memory. importance: higher = more important.
model MemoryItem {
  id          String   @id @default(cuid())
  workspaceId String
  roomId      String?
  title       String
  content     String
  importance  Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  room      Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

// High-priority project identity and mission. Separate from MemoryItem.
model ProjectContext {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// A decision summary generated from recent room messages.
// actionItems: JSON string array.
model Decision {
  id          String   @id @default(cuid())
  workspaceId String
  roomId      String?
  title       String
  summary     String
  actionItems String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  room      Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

// A unit of ingested knowledge (Phase 11 — Knowledge & RAG). A source is a
// document or block of text added to a workspace's knowledge base; on ingestion
// it is split into KnowledgeChunks and embedded so the AI Router can retrieve the
// most relevant passages and inject them into an agent's context. Knowledge may
// be workspace-wide (roomId null) or scoped to a single room.
//
// sourceType: "text" | "document"
// status:     "ready" | "failed"  (ingestion is synchronous in the MVP)
model KnowledgeSource {
  id          String   @id @default(cuid())
  workspaceId String
  roomId      String?
  title       String
  sourceType  String   @default("text")
  status      String   @default("ready")
  charCount   Int      @default(0)
  chunkCount  Int      @default(0)
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  room      Room?            @relation(fields: [roomId], references: [id], onDelete: SetNull)
  chunks    KnowledgeChunk[]

  @@index([workspaceId])
  @@index([roomId])
}

// One embedded chunk of a KnowledgeSource. workspaceId/roomId are denormalized
// from the parent source so retrieval can filter by scope without a join. The
// embedding is stored as a JSON array of floats; SQLite has no native vector
// type, so cosine similarity is computed in-process for the MVP. dimensions and
// embeddingModel are recorded so retrieval can skip chunks embedded with a
// different model/dimension than the live query embedding.
model KnowledgeChunk {
  id             String   @id @default(cuid())
  sourceId       String
  workspaceId    String
  roomId         String?
  chunkIndex     Int
  content        String
  embedding      String
  embeddingModel String
  dimensions     Int
  createdAt      DateTime @default(now())

  source    KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  room      Room?           @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([workspaceId])
  @@index([roomId])
}

// A multi-agent discussion (Phase 12 — Multi-Agent Discussion). Two or more AI
// teammates discuss a topic over a bounded number of rounds; each contribution
// is a DiscussionTurn. After the rounds a synthesizer agent produces a neutral
// summary, the points of consensus, and the open disagreements. A discussion can
// then yield a Decision (decisionId links to the generated Decision row).
//
// Discussion runs synchronously in the MVP (like knowledge ingestion), reusing
// the AI Router's provider factory and the Context Builder for each turn.
//
// status:        "completed" | "failed"
// consensus:     JSON string array of agreed points.
// disagreements: JSON string array of { point, positions } objects.
model Discussion {
  id            String   @id @default(cuid())
  workspaceId   String
  roomId        String
  topic         String
  rounds        Int      @default(2)
  status        String   @default("completed")
  summary       String?
  consensus     String?
  disagreements String?
  decisionId    String?
  createdById   String?
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  room      Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  turns     DiscussionTurn[]

  @@index([workspaceId])
  @@index([roomId])
}

// One agent's contribution in one round of a Discussion. agentId/agentName are
// stored directly (not a relation) so a turn keeps its attribution even if the
// agent is later renamed or removed — the discussion is an immutable record.
model DiscussionTurn {
  id           String   @id @default(cuid())
  discussionId String
  round        Int
  agentId      String
  agentName    String
  content      String
  provider     String
  model        String
  createdAt    DateTime @default(now())

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@index([discussionId])
}

// Tracks AI usage for cost/auditing.
model UsageLog {
  id           String   @id @default(cuid())
  userId       String?
  workspaceId  String?
  provider     String
  model        String
  inputTokens  Int?
  outputTokens Int?
  totalCost    Float?
  createdAt    DateTime @default(now())

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
}
