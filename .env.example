# Database
DATABASE_URL="file:./dev.db"

# AI provider keys are server-side only and never exposed to the frontend.
# When a key is left blank in development, the AI Router uses a local stub
# provider so the collaboration loop (mention an agent → it replies in-room)
# still works without secrets. Set a real key to get live responses.

# OpenAI provider (ARi)
OPENAI_API_KEY=""

# Anthropic provider (Cloudy)
ANTHROPIC_API_KEY=""
