# --- Database ---
# SQLite for local development. Keep schema PostgreSQL-compatible conceptually.
DATABASE_URL="file:./dev.db"

# --- AI Providers (server-side only — never expose to the frontend) ---
# ARi → OpenAI
OPENAI_API_KEY=""
# Cloudy → Anthropic
ANTHROPIC_API_KEY=""
# Gemini (Google) — now a working adapter, not just a placeholder
GEMINI_API_KEY=""

# --- Web search (Tavily) ---
# Gives every AI agent live internet access. Without it, search falls back to a
# clearly-labeled mock so the app still runs.
SEARCH_API_KEY=""

# --- Auth ---
# Real email + password auth with server-side sessions (see lib/auth/).
# These only seed the default account for `npm run db:seed` so you can log in
# locally; sign-up creates real accounts.
DEV_USER_EMAIL="van@hivemind.dev"
DEV_USER_NAME="Van"
DEV_USER_PASSWORD="password"
