# --- Database ---
# SQLite for local development. Keep schema PostgreSQL-compatible conceptually.
DATABASE_URL="file:./dev.db"

# --- AI Providers (server-side only — never expose to the frontend) ---
# ARi → OpenAI
OPENAI_API_KEY=""
# Cloudy → Anthropic
ANTHROPIC_API_KEY=""
# Gemini (Google) — now a working adapter, not just a placeholder
GEMINI_API_KEY=""

# --- Web search (Tavily) ---
# Gives every AI agent live internet access. Without it, search falls back to a
# clearly-labeled mock so the app still runs.
SEARCH_API_KEY=""

# --- Placeholder auth (MVP) ---
# A fake current user id used until Clerk is integrated.
DEV_USER_EMAIL="van@hivemind.dev"
DEV_USER_NAME="Van"
