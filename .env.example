# --- Database (PostgreSQL) ---
# Local dev: `docker compose up -d db` starts Postgres on localhost:5432.
# Apply the schema with `npm run db:deploy` (or `npm run db:migrate` in dev).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hivemind?schema=public"

# Used by the test suite (CI sets this to its Postgres service).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hivemind_test?schema=public"

# --- AI Providers (server-side only — never expose to the frontend) ---
# ARi → OpenAI
OPENAI_API_KEY=""
# Cloudy → Anthropic
ANTHROPIC_API_KEY=""
# Gemini (Google) — now a working adapter, not just a placeholder
GEMINI_API_KEY=""

# --- Web search (Tavily) ---
# Gives every AI agent live internet access. Without it, search falls back to a
# clearly-labeled mock so the app still runs.
SEARCH_API_KEY=""

# --- Auth ---
# Real email + password auth with server-side sessions (see lib/auth/).
# These only seed the demo account for `npm run db:seed` so you can log in
# locally; sign-up creates real accounts.
SEED_EMAIL="demo@hivemind.dev"
SEED_NAME="Demo"
SEED_PASSWORD="password"
