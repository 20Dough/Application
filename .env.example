# --- Database (PostgreSQL) ---
# Local dev: run Postgres (e.g. `docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16`)
# then point this at it. On Railway/Render the platform injects this for you.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hivemind?schema=public"

# --- AI Providers (server-side only — never expose to the frontend) ---
# ARi → OpenAI
OPENAI_API_KEY=""
# Cloudy → Anthropic
ANTHROPIC_API_KEY=""
# Sage → Google Gemini
GEMINI_API_KEY=""

# --- Auth ---
# Sign-up/sign-in is built in (username + password). Sessions are stored in the
# database and referenced by an httpOnly cookie — no extra config needed.
