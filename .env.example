# --- Database ---
# SQLite for local development. Keep schema PostgreSQL-compatible conceptually.
DATABASE_URL="file:./dev.db"

# --- AI Providers (server-side only — never expose to the frontend) ---
# ARi → OpenAI
OPENAI_API_KEY=""
# Cloudy → Anthropic
ANTHROPIC_API_KEY=""
# Sage → Google Gemini
GEMINI_API_KEY=""

# --- Auth ---
# Sign-up/sign-in is built in (username + password). Sessions are stored in the
# database and referenced by an httpOnly cookie — no extra config needed.
